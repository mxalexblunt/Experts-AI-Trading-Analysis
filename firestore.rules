rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function validString(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function validSupportTopic(topic) {
      return topic in [
        'app_issue',
        'market_data',
        'ai_analysis',
        'privacy',
        'other'
      ];
    }

    function validSupportRequest() {
      let data = request.resource.data;
      return request.auth != null
        && data.keys().hasOnly([
          'userUid',
          'topic',
          'message',
          'contact',
          'source',
          'pageUrl',
          'referrer',
          'userAgent',
          'status',
          'createdAt'
        ])
        && data.userUid == request.auth.uid
        && validSupportTopic(data.topic)
        && validString(data.message, 10, 4000)
        && validString(data.contact, 0, 200)
        && data.source == 'experts_hosting_support'
        && validString(data.pageUrl, 1, 500)
        && validString(data.referrer, 0, 500)
        && validString(data.userAgent, 0, 512)
        && data.status == 'new'
        && data.createdAt == request.time;
    }

    match /support_requests/{requestId} {
      allow create: if validSupportRequest();
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
